{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jogg.ai/schemas/smart-video/render-report.v1.schema.json",
  "title": "Smart Video Render Evidence Report v1",
  "type": "object",
  "$defs": {
    "successfulBrowserFailures": {
      "type": "object",
      "required": ["total_count", "detail_limit", "details_truncated", "counts", "details"],
      "properties": {
        "total_count": {"const": 0},
        "detail_limit": {"const": 20},
        "details_truncated": {"const": false},
        "counts": {
          "type": "object",
          "required": ["runtime_exceptions", "log_errors", "network_load_failures", "http_error_responses", "console_errors"],
          "properties": {
            "runtime_exceptions": {"const": 0},
            "log_errors": {"const": 0},
            "network_load_failures": {"const": 0},
            "http_error_responses": {"const": 0},
            "console_errors": {"const": 0}
          },
          "additionalProperties": false
        },
        "details": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_id", "version", "stage", "manifest_id", "identity", "design_strategy", "render_mode", "renderer", "screenshot", "checks", "runtime_attestation", "final_frame_review_status"],
  "properties": {
    "schema_id": {"const": "smart-video.render-report.v1"},
    "version": {"const": 1},
    "stage": {"const": "trusted_render_validation"},
    "manifest_id": {"type": "string", "minLength": 1},
    "identity": {"$ref": "slide-generation-request.v1.schema.json#/$defs/identity"},
    "design_strategy": {"$ref": "slide-generation-request.v1.schema.json#/$defs/strategy"},
    "render_mode": {"enum": ["html_svg", "echarts"]},
    "renderer": {"type": "object", "required": ["id", "version", "trust"], "properties": {"id": {"const": "smart-video-local-renderer"}, "version": {"type": "string", "minLength": 1}, "trust": {"const": "trusted_local"}}, "additionalProperties": false},
    "screenshot": {"type": "object", "required": ["path", "sha256", "bytes", "width", "height"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "checks": {"type": "object", "required": ["nonblank_visible_pixels", "overflow", "overlap", "clipping", "contrast_legibility", "final_frame_completeness", "strategy_root_validation", "runtime_errors", "resource_loads"], "properties": {"nonblank_visible_pixels": {"const": "passed"}, "overflow": {"const": "passed"}, "overlap": {"const": "passed"}, "clipping": {"const": "passed"}, "contrast_legibility": {"const": "passed"}, "final_frame_completeness": {"const": "passed"}, "strategy_root_validation": {"const": "passed"}, "runtime_errors": {"const": "passed"}, "resource_loads": {"const": "passed"}}, "additionalProperties": false},
    "runtime_attestation": {
      "type": "object",
      "required": ["schema_id", "version", "runtime_identity", "manifest_id", "author_sha256", "adapter_sha256", "screenshot_sha256", "final_timeline_seconds", "observed_root"],
      "properties": {
        "schema_id": {"const": "smart-video.runtime-attestation.v1"},
        "version": {"const": 1},
        "runtime_identity": {
          "type": "object",
          "required": ["schema_id", "version", "build_id", "files"],
          "properties": {
            "schema_id": {"const": "smart-video.trusted-runtime-identity.v1"},
            "version": {"const": 1},
            "build_id": {"const": "smart-video-slide-runtime-1.0.0"},
            "files": {
              "type": "object",
              "required": ["backend/main.py", "backend/api/framevideo.py", "backend/api/runtime_readiness.py", "backend/api/video_studio.py", "backend/services/framevideo_project.py", "backend/services/narration_authority.py", "backend/services/runtime_readiness.py", "backend/services/video_content_pipeline/smart_video_adapter.py", "backend/services/video_studio_echarts_mg.py", "backend/services/video_studio_works.py", "render/animated_overlay.py", "render/chrome_capture.mjs", "render/chromium_session.mjs", "render/ffmpeg_adapter.py", "render/framevideo_adapter.py", "vendor/USA.json", "vendor/echarts.min.js", "vendor/gsap.min.js", "vendor/smart-video-echarts-timeline.js"],
              "properties": {
                "backend/main.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/api/framevideo.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/api/runtime_readiness.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/api/video_studio.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/services/framevideo_project.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/services/narration_authority.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/services/runtime_readiness.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/services/video_content_pipeline/smart_video_adapter.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/services/video_studio_echarts_mg.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "backend/services/video_studio_works.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "render/animated_overlay.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "render/chrome_capture.mjs": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "render/chromium_session.mjs": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "render/ffmpeg_adapter.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "render/framevideo_adapter.py": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "vendor/USA.json": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "vendor/echarts.min.js": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "vendor/gsap.min.js": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
                "vendor/smart-video-echarts-timeline.js": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "manifest_id": {"type": "string", "minLength": 1},
        "author_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
        "adapter_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
        "screenshot_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
        "final_timeline_seconds": {"type": "number", "minimum": 0},
        "observed_root": {
          "type": "object",
          "required": ["design_strategy", "design_version", "manifest_id", "render_mode", "author_spec_sha256", "adapter_state", "final_action", "canvas_pixels", "echarts_text_count", "echarts_text_clipped_count", "echarts_text_overlap_pair_count", "echarts_text_measurement_complete", "browser_failures", "capture_context"],
          "properties": {
            "design_strategy": {"type": "string", "minLength": 1},
            "design_version": {"type": "string", "minLength": 1},
            "manifest_id": {"type": "string", "minLength": 1},
            "render_mode": {"enum": ["html_svg", "echarts"]},
            "author_spec_sha256": {"oneOf": [{"type": "null"}, {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"}]},
            "adapter_state": {"enum": ["settled", "trusted-ready"]},
            "final_action": {"oneOf": [{"type": "null"}, {"const": "hold_conclusion"}]},
            "canvas_pixels": {"type": "integer", "minimum": 0},
            "echarts_text_count": {"type": "integer", "minimum": 0},
            "echarts_text_clipped_count": {"const": 0},
            "echarts_text_overlap_pair_count": {"const": 0},
            "echarts_text_measurement_complete": {"const": true},
            "browser_failures": {"$ref": "#/$defs/successfulBrowserFailures"},
            "capture_context": {"const": "adapter_page"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "final_frame_review_status": {"const": "pending_render"}
  },
  "additionalProperties": false
}
