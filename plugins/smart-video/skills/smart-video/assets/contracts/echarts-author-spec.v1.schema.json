{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jogg.ai/schemas/smart-video/echarts-author-spec.v1.schema.json",
  "title": "Smart Video ECharts Author Spec v1",
  "type": "object",
  "required": ["schema_id", "version", "stage", "identity", "design_strategy", "visual_system", "render_mode", "source_data", "source_data_sha256", "final_frame_review_status", "data_bindings", "option"],
  "properties": {
    "schema_id": {"const": "smart-video.echarts-author-spec.v1"},
    "version": {"const": 1},
    "stage": {"const": "llm_author"},
    "identity": {"$ref": "slide-generation-request.v1.schema.json#/$defs/identity"},
    "design_strategy": {"$ref": "slide-generation-request.v1.schema.json#/$defs/strategy"},
    "visual_system": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "render_mode": {"const": "echarts"},
    "source_data": {},
    "source_data_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
    "final_frame_review_status": {"const": "pending_render"},
    "data_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_pointer", "option_pointer"],
        "properties": {
          "source_pointer": {"type": "string", "pattern": "^(?:$|/)"},
          "option_pointer": {"type": "string", "pattern": "^(?:$|/)"},
          "duplicate_display_authorization_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "option": {"type": "object", "minProperties": 1}
  },
  "additionalProperties": false
}
