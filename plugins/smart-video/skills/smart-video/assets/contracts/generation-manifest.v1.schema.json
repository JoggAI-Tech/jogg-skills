{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jogg.ai/schemas/smart-video/generation-manifest.v1.schema.json",
  "title": "Smart Video Generation Manifest v1",
  "type": "object",
  "required": ["schema_id", "version", "manifest_id", "request_id", "identity", "design_strategy", "visual_system", "aspect_ratio", "shot_type", "render_mode", "expression_grammar_version", "selection_provenance_sha256", "source_content_sha256", "source_data_sha256", "author_spec_sha256", "duration_seconds", "motion_phases", "final_frame_review_status", "artifacts"],
  "properties": {
    "schema_id": {"const": "smart-video.generation-manifest.v1"},
    "version": {"const": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "identity": {"$ref": "slide-generation-request.v1.schema.json#/$defs/identity"},
    "design_strategy": {"$ref": "slide-generation-request.v1.schema.json#/$defs/strategy"},
    "visual_system": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "aspect_ratio": {"const": "16:9"},
    "shot_type": {"enum": ["html_only", "avatar_html", "broll_html"]},
    "render_mode": {"enum": ["html_svg", "echarts"]},
    "expression_grammar_version": {"const": "5.0.0"},
    "selection_provenance_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
    "source_content_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
    "source_data_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
    "author_spec_sha256": {"oneOf": [{"type": "null"}, {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"}]},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "motion_phases": {"type": "array", "minItems": 1},
    "final_frame_review_status": {"const": "pending_render"},
    "artifacts": {"type": "object", "required": ["author"], "properties": {"author": {"allOf": [{"$ref": "#/$defs/artifact"}, {"properties": {"stage": {"const": "llm_author"}}}]}, "adapter": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}}, "additionalProperties": false}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"render_mode": {"const": "echarts"}}, "required": ["render_mode"]},
      "then": {
        "properties": {
          "author_spec_sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"},
          "artifacts": {"properties": {"author": {"properties": {"media_type": {"const": "application/json"}}}}},
          "motion_phases": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [{"$ref": "#/$defs/echartsEstablishPhase"}],
            "items": {"$ref": "#/$defs/echartsPhase"},
            "contains": {"$ref": "#/$defs/echartsHoldPhase"},
            "minContains": 1,
            "maxContains": 1
          }
        }
      },
      "else": {
        "properties": {
          "author_spec_sha256": {"type": "null"},
          "artifacts": {"properties": {"author": {"properties": {"media_type": {"const": "text/html"}}}}},
          "motion_phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/htmlPhase"}}
        }
      }
    },
    {
      "if": {"properties": {"artifacts": {"properties": {"adapter": {"type": "object"}}, "required": ["adapter"]}}},
      "then": {
        "properties": {
          "artifacts": {
            "properties": {
              "adapter": {
                "properties": {
                  "stage": {"const": "trusted_local_adapter"},
                  "media_type": {"const": "text/html"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "phaseBase": {
      "type": "object",
      "required": ["id", "start_seconds", "end_seconds", "state", "animation_name", "echarts_action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "state": {"enum": ["active", "stable_hold"]},
        "animation_name": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "echarts_action": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/echartsAction"}]}
      },
      "additionalProperties": false
    },
    "htmlPhase": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "active"}, "animation_name": {"type": "string", "minLength": 1}, "echarts_action": {"type": "null"}}}]},
        {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "stable_hold"}, "animation_name": {"type": "null"}, "echarts_action": {"type": "null"}}}]}
      ]
    },
    "echartsPhase": {
      "oneOf": [
        {"$ref": "#/$defs/echartsEstablishPhase"},
        {"$ref": "#/$defs/echartsRevealPhase"},
        {"$ref": "#/$defs/echartsHighlightPhase"},
        {"$ref": "#/$defs/echartsAnnotationPhase"},
        {"$ref": "#/$defs/echartsHoldPhase"}
      ]
    },
    "echartsEstablishPhase": {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "active"}, "animation_name": {"type": "null"}, "echarts_action": {"$ref": "#/$defs/establishChartAction"}}}]},
    "echartsRevealPhase": {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "active"}, "animation_name": {"type": "null"}, "echarts_action": {"$ref": "#/$defs/revealSeriesAction"}}}]},
    "echartsHighlightPhase": {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "active"}, "animation_name": {"type": "null"}, "echarts_action": {"$ref": "#/$defs/highlightDataAction"}}}]},
    "echartsAnnotationPhase": {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "active"}, "animation_name": {"type": "null"}, "echarts_action": {"$ref": "#/$defs/showAnnotationAction"}}}]},
    "echartsHoldPhase": {"allOf": [{"$ref": "#/$defs/phaseBase"}, {"properties": {"state": {"const": "stable_hold"}, "animation_name": {"type": "null"}, "echarts_action": {"$ref": "#/$defs/holdConclusionAction"}}}]},
    "echartsAction": {
      "oneOf": [
        {"$ref": "#/$defs/establishChartAction"},
        {"$ref": "#/$defs/revealSeriesAction"},
        {"$ref": "#/$defs/highlightDataAction"},
        {"$ref": "#/$defs/showAnnotationAction"},
        {"$ref": "#/$defs/holdConclusionAction"}
      ]
    },
    "establishChartAction": {"type": "object", "required": ["type"], "properties": {"type": {"const": "establish_chart"}}, "additionalProperties": false},
    "revealSeriesAction": {"type": "object", "required": ["type", "series_ids"], "properties": {"type": {"const": "reveal_series"}, "series_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "highlightDataAction": {"type": "object", "required": ["type", "series_id", "data_indices"], "properties": {"type": {"const": "highlight_data"}, "series_id": {"type": "string", "minLength": 1}, "data_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}}, "additionalProperties": false},
    "showAnnotationAction": {"type": "object", "required": ["type", "series_id", "annotation"], "properties": {"type": {"const": "show_annotation"}, "series_id": {"type": "string", "minLength": 1}, "annotation": {"enum": ["markPoint", "markLine", "markArea"]}}, "additionalProperties": false},
    "holdConclusionAction": {"type": "object", "required": ["type"], "properties": {"type": {"const": "hold_conclusion"}}, "additionalProperties": false},
    "artifact": {"type": "object", "required": ["stage", "media_type", "path", "sha256"], "properties": {"stage": {"enum": ["llm_author", "trusted_local_adapter"]}, "media_type": {"enum": ["text/html", "application/json"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "slide-generation-request.v1.schema.json#/$defs/sha256"}}, "additionalProperties": false}
  }
}
