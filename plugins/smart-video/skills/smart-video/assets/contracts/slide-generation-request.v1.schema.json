{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jogg.ai/schemas/smart-video/slide-generation-request.v1.schema.json",
  "title": "Smart Video Slide Generation Request v1",
  "type": "object",
  "required": [
    "schema_id", "version", "request_id", "identity", "design_strategy",
    "visual_system", "aspect_ratio", "shot_type", "render_mode",
    "duration_seconds", "source_content", "source_content_sha256",
    "source_data", "source_data_sha256", "html_data_bindings",
    "final_frame_review_status"
  ],
  "properties": {
    "schema_id": {"const": "smart-video.slide-generation-request.v1"},
    "version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "design_strategy": {"$ref": "#/$defs/strategy"},
    "visual_system": {"$ref": "#/$defs/lockedVisualSystemReference"},
    "aspect_ratio": {"const": "16:9"},
    "shot_type": {"enum": ["html_only", "avatar_html", "broll_html"]},
    "render_mode": {"enum": ["html_svg", "echarts"]},
    "duration_seconds": {"type": "number", "minimum": 2.5},
    "source_content": {
      "type": "object",
      "required": ["screen_content", "source_bindings"],
      "properties": {
        "screen_content": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/screenContent"}
        },
        "source_bindings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id"],
            "properties": {"id": {"type": "string", "minLength": 1}},
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "source_content_sha256": {"$ref": "#/$defs/sha256"},
    "source_data": {},
    "source_data_sha256": {"$ref": "#/$defs/sha256"},
    "html_data_bindings": {
      "type": "array", "items": {"$ref": "#/$defs/htmlDataBinding"}
    },
    "final_frame_review_status": {"const": "pending_render"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"render_mode": {"const": "echarts"}},
        "required": ["render_mode"]
      },
      "then": {"properties": {"html_data_bindings": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "required": ["video_id", "shot_id", "segment_id", "slide_id", "clip_id"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "shot_id": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "slide_id": {"type": "string", "minLength": 1},
        "clip_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "required": ["id", "version", "selection_source"],
      "properties": {
        "id": {"const": "smart_video_slide_design"},
        "version": {"const": "1.0.0"},
        "selection_source": {"const": "production_default"}
      },
      "additionalProperties": false
    },
    "lockedVisualSystemReference": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "screenContent": {
      "type": "object",
      "required": ["content_id", "text", "source_binding_ids"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "source_binding_ids": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "htmlDataBinding": {
      "type": "object",
      "required": ["source_pointer", "target_type", "target_id"],
      "properties": {
        "source_pointer": {"type": "string", "pattern": "^(?:$|/)"},
        "target_type": {"enum": ["content", "annotation"]},
        "target_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
