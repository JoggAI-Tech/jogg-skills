      "capabilities",
      "routes",
      "trusted_runtime_identity_bytes_sha256",
      "runtime_inventory_sha256",
      "runtime_identity"
    ],
    "measurement_owner": "running_npm_process",
    "replay_policy": "single_use_nonce",
    "transport": "explicit_loopback_http_origin_from_preflight",
    "cryptographic_process_identity": false,
    "trust_boundary": "same-user hostile local processes are out of scope"
  },
  "runtime_version_source": "../../../../runtime-bom.json#packages/@joggai/smartvideo-runtime",
  "readiness_rule": "send a fresh nonce directly to the preflight loopback origin and accept only the exact canonical response matching the pinned identity, identity bytes hash, inventory hash, BOM-pinned runtime package version, routes, and capabilities; never compare the aggregate package version to an independently versioned child package",
  "current_acceptance_status": "npm_managed_bom_pinned_runtime_must_pass_direct_challenge",
  "required_npm_change": "bootstrap installs the exact aggregate and child package versions declared by runtime-bom.json; no private or plugin-bundled npm directory is required",
  "failure_code": "unsupported_render_runtime"
