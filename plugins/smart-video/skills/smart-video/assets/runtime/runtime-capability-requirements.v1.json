{
  "schema_id": "smart-video.runtime-capability-requirements.v1",
  "version": "2.2.0",
  "status": "direct_loopback_challenge_required",
  "required_capabilities": [
    "html_author_route",
    "echarts_author_route",
    "trusted_runtime_identity"
  ],
  "required_routes": {
    "html_author_route": "PATCH /api/v1/video-studio/projects/{project_id}/shots/{shot_id}/html-author",
    "echarts_author_route": "PATCH /api/v1/video-studio/projects/{project_id}/shots/{shot_id}/echarts-author"
  },
  "trusted_identity_requirement": {
    "requirements_locator": "assets/runtime/trusted-runtime-identity.v1.json",
    "requirements_file_sha256": "0359596680870a158b11984ddd699b0c616c2cb188da41cdda1bbb8e38588d9b",
    "meaning": "required_identity_bytes_only_not_runtime_implementation_evidence"
  },
  "required_attestation": {
    "endpoint": "POST /api/v1/runtime-readiness/attest",
    "challenge_owner": "skill_validator",
    "challenge_kind": "fresh_256_bit_nonce",
    "response_schema_id": "smart-video.runtime-readiness-attestation.v1",
    "required_response_fields": [
